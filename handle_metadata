#!/usr/bin/env perl

## no critic qw( ValuesAndExpressions::ProhibitAccessOfPrivateData ValuesAndExpressions::ProhibitLeadingZeros )
## no critic qw( Lax::ProhibitLeadingZeros::ExceptChmod ErrorHandling::RequireCarping Bangs::ProhibitNumberedNames )
## no critic qw( ValuesAndExpressions::RequireQuotedHeredocTerminator ValuesAndExpressions::RestrictLongStrings )
## no critic qw( ValuesAndExpressions::ProhibitInterpolationOfLiterals ValuesAndExpressions::ProhibitMagicNumbers )

use 5.014;
use strict;
use warnings;

use Fcntl      qw( :mode O_NONBLOCK O_RDONLY S_ISDIR S_ISLNK );
use File::Spec ();
use File::stat;  # overrides perl's stat and lstat
use File::Temp 'tempfile';
use Cwd 'abs_path';
use Getopt::Long;
use IO::Select ();
use IPC::Open3 'open3';
use JSON::PP ();
use Symbol 'gensym';
use POSIX 'mkfifo';

our $NOTE_NS = 'gitperms';  # What namespace are we using for notes?

# Where the kernel publishes SELinux's enforcing state, most likely first.
# /selinux was the original mount point; every current distribution puts the
# selinuxfs under /sys/fs instead, so the old path alone found nothing.

our @SELINUX_ENFORCE = ( '/sys/fs/selinux/enforce', '/selinux/enforce' );

# The ext2 attribute ioctls are FS_IOC_GETFLAGS = _IOR( 'f', 1, long ) and
# FS_IOC_SETFLAGS = _IOW( 'f', 2, long ). An ioctl number encodes the size of
# its argument, so both values depend on sizeof(long) -- 0x80086601/0x40086602
# on a 64-bit build, 0x80046601/0x40046602 on a 32-bit one. Derive them from
# the running perl's long instead of hardcoding either variant.
#
#   direction << 30 | size << 16 | type << 8 | number   (asm-generic/ioctl.h)
#   direction: _IOC_WRITE = 1, _IOC_READ = 2

use constant LONG_SIZE => length pack 'L!', 0;

use constant {
  FS_IOC_GETFLAGS => ( 2 << 30 ) | ( LONG_SIZE() << 16 ) | ( ord( 'f' ) << 8 ) | 1,
  FS_IOC_SETFLAGS => ( 1 << 30 ) | ( LONG_SIZE() << 16 ) | ( ord( 'f' ) << 8 ) | 2,
};

# Attribute bits the kernel reports but will not accept back from userspace
# (linux/fs.h). They are masked out of a saved snapshot and taken from the
# file itself when restoring, which is what Linux::Ext2::Attributes' strip()
# and set_attrs() did.

use constant {
  FS_DIRTY_FL     => 0x00000100,  # compression: dirty
  FS_NOCOMP_FL    => 0x00000400,  # compression: do not compress
  FS_ECOMPR_FL    => 0x00000800,  # compression: compression error
  FS_INDEX_FL     => 0x00001000,  # hash-indexed directory
  FS_HUGE_FILE_FL => 0x00040000,  # ext4: huge file
  FS_EXTENT_FL    => 0x00080000,  # ext4: inode uses extents
};

use constant FS_READONLY_FLAGS => FS_DIRTY_FL | FS_NOCOMP_FL | FS_ECOMPR_FL | FS_INDEX_FL | FS_HUGE_FILE_FL | FS_EXTENT_FL;

# gitperms may be installed anywhere -- a linked worktree's .git is a file, a
# submodule's is a pointer, and a copy on PATH has no repository above it at
# all -- so ask git where the repository is instead of deriving it from this
# script's own path. Resolve both before exporting either: with GIT_DIR set
# and no work tree, git answers --show-toplevel with the current directory.

my $git_dir = get_git_dir();
my $topdir  = get_toplevel();

$ENV{ GIT_DIR } = $git_dir;

$ENV{ GIT_WORK_TREE } = $topdir;

chdir $topdir
  or die "Unable to change to git top level directory: $!\n";

my $se_enforcing = selinux_enforcing();

GetOptions(
  'create-on-missing' => \my $create_on_missing,
  force               => \my $force,
  help                => \my $help,
  quiet               => \my $quiet,
  save                => \my $save,
  set                 => \my $set,
) or die "Problem parsing options, exiting.\n";

my $help_txt = <<EOH;

usage: $0 [options ...]

  --save               Save a note with current permissions information.
  --force              If there is already a note, overwrite it instead of dying.

  --set                Set permissions according to the note.
  --create-on-missing  If a note does not exist, create it without prompting the user.

  --quiet              Don't be so noisy.
  --help               This screen.

EOH

die $help_txt
  if defined $help;

die "either --save or --set is required\n"
  if ! defined $save && ! defined $set;

die "--save and --set are mutually exclusive\n"
  if defined $save && defined $set;

my %metadata;

# Get all files git knows about.
#
# -z is what makes the path usable: without it git C-quotes any path holding
# a double quote, a backslash, a control character, or -- under the default
# core.quotePath -- a byte above 0x7f, and the quoted string is not the name
# lstat wants. NUL termination removes the quoting instead of asking us to
# undo it, and it is also the only separator a filename cannot contain: a
# newline is a legal character in one, so splitting on newlines is unsafe
# even where nothing is quoted.

my @files = split /\0/, ( run_cmd( qw( git ls-tree -r -t -z HEAD ) ) )[0];

# Get modified files so we can ignore them
my @ignore = split /\0/, ( run_cmd( qw( git status --porcelain -z --untracked-files=no ) ) )[0];

# The blob HEAD holds for each path. `git status` says a file is modified
# without saying whether its content or only its mode changed, and no status
# format separates the two -- so the question is answered by hashing the file
# on disk and comparing it with this.

my %head_blob;

for my $record ( @files ) {

  my ( $sha1, $file ) = split_ls_tree( $record );

  $head_blob{ $file } = $sha1
    if defined $file;

}

# Each status record is "XY <path>": the staged status in column 1, the
# worktree status in column 2. A staged-only change is therefore "M  file"
# and one changed in both is "MM file", neither of which has a space in
# column 1 -- so matching a shape that required one saw worktree changes
# alone and let every staged change through.
#
# A file whose content is mid-edit is not ours to record or restore. Drift in
# its *mode* is the opposite: it is the damage gitperms exists to repair, and
# the executable bit -- the one mode bit git itself reports -- was the case
# the ignore list used to decline. So a plain modification whose content
# still matches HEAD stays off the list. Anything else git reports (a
# deletion, rename, copy, addition, or unmerged path) is work in progress
# whatever its mode, and so is a modification that changed content in either
# column.
#
# A rename or copy is reported as "XY <to>" followed by a second record
# holding the path it came from; both names belong to the same work in
# progress.

my %ignore;

while ( defined( my $entry = shift @ignore ) ) {

  next if length $entry < 4;

  my ( $x, $y ) = ( substr( $entry, 0, 1 ), substr( $entry, 1, 1 ) );
  my $path = substr $entry, 3;

  my $modification_only = ! grep { $_ ne 'M' && $_ ne q{ } } $x, $y;

  $ignore{ $path } = undef
    if ! $modification_only || ! content_matches_head( $path, $head_blob{ $path } );

  next
    if $x ne 'R' && $x ne 'C' && $y ne 'R' && $y ne 'C';

  my $source = shift @ignore;

  $ignore{ $source } = undef
    if defined $source;

}

if ( defined $save ) {

  get_metadata_from_system();
  set_note();
  print "Done saving ...\n";

} elsif ( defined $set ) {

  if ( get_note() ) {

    # note existed
    set_metadata_in_system();
    print "Done setting ...\n";

  }
} else {

  die "Unknown and unhandled error! How'd you get here?\n";

}

exit 0;

################################################################################################

# Run a command with no shell involved, capturing its stdout and stderr
# separately. Returns ( $stdout, $stderr, $syserr ) with one trailing newline
# chomped from each stream, where $syserr is the raw $? of the finished child
# -- or -1 when the command could not be spawned at all, in which case the
# reason is returned as $stderr.

sub run_cmd {

  my @cmd = @_;

  my ( $child_in, $child_out );
  my $child_err = gensym;

  my $pid = eval { open3 $child_in, $child_out, $child_err, @cmd };

  return ( q{}, $@, -1 )
    if ! $pid;

  # Nothing here feeds a command on stdin, and an open pipe would hang any
  # child that tried to read one.
  close $child_in;

  my ( $out, $err ) = ( q{}, q{} );

  # Read whichever pipe has data. Draining one to EOF first deadlocks as soon
  # as the other fills its pipe buffer, which a large `git ls-tree` easily
  # does.
  my %buffer_for = ( fileno $child_out => \$out, fileno $child_err => \$err );

  my $select = IO::Select->new( $child_out, $child_err );

  while ( my @ready = $select->can_read ) {

    for my $fh ( @ready ) {

      my $bytes = sysread $fh, my $buf, 8192;

      if ( ! $bytes ) {

        $select->remove( $fh );
        close $fh;
        next;

      }

      ${ $buffer_for{ fileno $fh } } .= $buf;

    }
  } ## end while ( my @ready = ...)

  waitpid $pid, 0;

  my $syserr = $?;

  chomp $out;
  chomp $err;

  return ( $out, $err, $syserr );

} ## end sub run_cmd

# Split one `git ls-tree -z` record, "<mode> <type> <object>\t<path>", into
# its object name and its path. The tab is the only field separator, and
# everything after it is the path -- which may itself contain a newline, so
# it is taken by position rather than matched. Returns an empty list for a
# record with no tab at all.

sub split_ls_tree {

  my ( $record ) = @_;

  my ( $info, $file ) = split /\t/, $record, 2;

  return
    if ! defined $file;

  return ( ( split / /, $info )[2], $file );

}

# Whether the file on disk still holds the content HEAD recorded for it,
# which is what separates a file whose mode has drifted -- the damage
# gitperms exists to repair -- from one that is being edited.
#
# hash-object applies the same filters git would, so a repository using
# clean/smudge or end-of-line conversion is compared on the same terms git
# compares it. Anything that cannot be hashed (a path not in HEAD, an
# unreadable file, a symlink, whose blob is its target text rather than the
# content hash-object reads) answers no, which leaves the file ignored.

sub content_matches_head {

  my ( $file, $head_sha ) = @_;

  return 0
    if ! defined $head_sha;

  my ( $sha, undef, $syserr ) = run_cmd( qw( git hash-object -- ), $file );

  return 0
    if $syserr;

  return $sha eq $head_sha;

}

# Whether SELinux is enforcing, which is the only reason to restore a file's
# security context afterwards. The kernel answers with a single character in
# a pseudo-file, '1' when it is enforcing.
#
# This used to be `qx/cat \/selinux\/enforce/`: one path, which no current
# distribution has, so every run forked a cat that printed a complaint --
# under --quiet as much as without it -- and the answer was always false. It
# was not merely reading the wrong file: the value has to be stripped before
# it is believed, because "0\n" is a true string in perl, so an SELinux
# system that was *not* enforcing would have been read as one that was.
#
# The first path that opens is the answer; a path that is absent (or that
# cannot be read) simply moves on to the next.

sub selinux_enforcing {

  for my $path ( @SELINUX_ENFORCE ) {

    open my $fh, '<', $path
      or next;

    my $value = <$fh>;

    close $fh;

    next if ! defined $value;

    chomp $value;

    return $value eq '1';

  }

  return 0;

} ## end sub selinux_enforcing

sub get_git_dir {

  my ( $git_dir, $err, $syserr ) = run_cmd( qw( git rev-parse --git-dir ) );

  die "System error: $syserr\n$err\n"
    if $syserr;

  die "Unable to get git directory: $err\n"
    if $err;

  # git answers with a path relative to the current directory whenever it can,
  # and the caller is about to chdir to the top level.
  my $abs_git_dir = abs_path( $git_dir )
    or die "Unable to resolve git directory '$git_dir': $!\n";

  return $abs_git_dir;

} ## end sub get_git_dir

sub get_toplevel {

  my ( $toplevel, $err, $syserr ) = run_cmd( qw( git rev-parse --show-toplevel ) );

  die "System error: $syserr\n$err\n"
    if $syserr;

  die "Unable to get top level directory: $err\n"
    if $err;

  $toplevel = File::Spec->canonpath( $toplevel );

  # git <= 2.11 answers --show-toplevel from inside .git with an empty string
  # and exit 0 rather than an error, and perl <= 5.22 reads chdir('') as
  # chdir() and moves to $HOME -- both inside the range `use 5.014` claims to
  # support. The pairing left the script applying a snapshot to whatever
  # tracked paths happened to exist under the home directory.
  die "Unable to get top level directory: git reported an empty path\n"
    if ! length $toplevel;

  return $toplevel;

}

sub get_metadata_from_system {

  for my $f ( @files ) {

    my ( $sha1, $file ) = split_ls_tree( $f );

    next if ! defined $file;

    next if exists $ignore{ $file };

    my $md = $metadata{ $sha1 } ||= {};

    if ( my $st = lstat $file ) {

      my $inode = $md->{ $st->ino } ||= {};

      ## no critic qw( ValuesAndExpressions::ProhibitMagicNumbers )
      my $ftype = ( $st->mode & 0170000 ) >> 12;

      # HL means "this record already holds another name for the same inode",
      # which is the only thing the restore can act on: it relinks every name
      # after the first back to it. A record with a single name and nlink > 1
      # -- the file's other links are outside the repository, or untracked --
      # is an ordinary file as far as we are concerned.
      #
      # The test was `$inode != {}`, which compares the address of the record
      # against that of a fresh anonymous hash and so was always true. Every
      # such file was typed HL, and the restore then hit its own "how did you
      # get here?!" guard and skipped the file outright: no mode, no owner, no
      # timestamps, no attributes.

      my $seen_this_inode = keys %{ $inode };

      $inode->{ type }
        = ( $st->rdev || $ftype == 1 || $ftype == 12 )                      ? 'CF'
        : ( ! S_ISDIR( $st->mode ) && $st->nlink > 1 && $seen_this_inode )  ? 'HL'
        : S_ISDIR( $st->mode )                                              ? 'DIR'
        : S_ISLNK( $st->mode )                                              ? 'SL'
        :                                                                     'RF';

      $inode->{ $_ } = $st->$_ for qw( dev ino mode nlink uid gid rdev size atime mtime ctime blksize blocks );

      $inode->{ chmod } = sprintf '%04o', $inode->{ mode } & 07777;

      push @{ $inode->{ name } }, $file;

      my $attributes = get_file_flags( $file );

      if ( defined $attributes ) {

        $inode->{ extnd_attr } = $attributes & ~FS_READONLY_FLAGS;

      } else {

        ! defined $quiet && warn "Problem getting extended attributes on $file ($!).\n";

      }
    } else {

      ! defined $quiet && warn "Problem getting stat on $file ($!), skipping.\n";
      next;

    }
  } ## end for my $f ( @files)

  return;

} ## end sub get_metadata_from_system

sub set_metadata_in_system { ## no critic qw( Subroutines::ProhibitExcessComplexity )

  my ( %chown_file, %chmod_file, %touch_file, %extnd_attr, @restor_ctx );

  for my $sha1 ( keys %metadata ) {

    my $md = $metadata{ $sha1 };

    for my $inode ( keys %$md ) { ## no critic qw( References::ProhibitDoubleSigils )

      my $attr = $md->{ $inode };

      # Don't do anything for symbolic links
      next if $attr->{ type } eq 'SL';

      ! defined $quiet && warn "$sha1, $inode has multiple names, only the first one will be handled"
        if ( @{ $attr->{ name } } > 1 ) && ( $attr->{ type } ne 'HL' );

      my $name = shift @{ $attr->{ name } };

      next if exists $ignore{ $name };

      do { warn "$name does not exist, skipping\n"; next }
        if ( ! -e $name ) && ( $attr->{ type } ne 'HL' );

      if ( $attr->{ type } eq 'HL' ) { ## no critic qw( ControlStructures::ProhibitCascadingIfElse )

        # Remove all but the first file
        # Hardlink removed files to first file.

        if ( @{ $attr->{ name } } == 0 ) {

          warn "No linked files (how did you get here?!), skipping\n";
          next;

        }

        my $files = join ', ', @{ $attr->{ name } };

        ! defined $quiet && warn "unlinking $files\n";

        my $removed = unlink @{ $attr->{ name } };

        warn "Unable to remove all files.\n"
          if $removed != @{ $attr->{ name } };

        ! defined $quiet && warn "Hardlinking $files to $name\n";

        for my $link ( @{ $attr->{ name } } ) {

          my $linked = link $name, $link;
          warn "Unable to link $name to $link: $!\n"
            unless $linked;

        }
      } elsif ( $attr->{ type } eq 'CF' ) {

        make_special_file( $name, $attr->{ mode }, $attr->{ rdev } );

      } elsif ( $attr->{ type } eq 'DIR' ) {

        if ( ! -d $name ) {

          warn "$name exists and is not a directory, skipping\n";
          next;

        }

      } elsif ( $attr->{ type } ne 'RF' ) {

        ! defined $quiet && warn sprintf "Unknown file type or type not set for %s\n", join ', ', @{ $attr->{ name } };
        next;

      }

      my $chown_attr = sprintf '%s_%s', $attr->{ uid }, $attr->{ gid };
      push @{ $chown_file{ $chown_attr } }, $name;

      #push @{ $chmod_file{ $attr->{ mode } } }, $name;
      push @{ $chmod_file{ $attr->{ chmod } } }, $name;

      my $time_attr = sprintf '%s_%s', $attr->{ atime }, $attr->{ mtime };
      push @{ $touch_file{ $time_attr } }, $name;

      $extnd_attr{ $name } = $attr->{ extnd_attr };

      push @restor_ctx, $name;

    } ## end for my $inode ( keys...)
  } ## end for my $sha1 ( keys...)

  chown_file( \%chown_file );
  chmod_file( \%chmod_file );
  touch_file( \%touch_file );
  extnd_attr( \%extnd_attr );
  restor_ctx( \@restor_ctx );

  return;

} ## end sub set_metadata_in_system

sub set_note {

  my ( $fh, $filename ) = tempfile( unlink => 1 );

  # canonical keeps the key order stable so successive notes diff cleanly;
  # pretty keeps the note readable through `git notes show`.
  print { $fh } JSON::PP->new->utf8->canonical->pretty->encode( \%metadata );

  # git reads the file itself, so the buffer has to reach disk first.
  close $fh
    or warn "Unable to write the note to $filename: $!\n";

  my @cmd = ( qw( git notes --ref ), $NOTE_NS, qw( add HEAD -F ), $filename );

  push @cmd, '--force' if defined $force;

  my ( $out, $err ) = run_cmd( @cmd );
  ! defined $quiet && warn "$out\n$err" if $err;

  return;

} ## end sub set_note

sub get_note {

  # Whether a note exists is asked of `git notes list`, which answers with an
  # exit status: 0 when there is one, 1 when there is not, 128 when the object
  # itself will not resolve. The missing case used to be recognised by
  # matching git's own "No note found for object" -- and git lowercased that
  # sentence somewhere between v1.8.0 and v2.43.0, so the branch stopped being
  # reachable, --create-on-missing silently did nothing, and the guidance
  # below was replaced by a raw error. Human-readable output is not an
  # interface; the exit status is.

  my ( undef, $err, $syserr ) = run_cmd( qw( git notes --ref ), $NOTE_NS, qw( list HEAD ) );

  my $exit = $syserr >> 8;

  if ( $syserr && $exit != 1 ) {

    warn "$err\n\nNot setting metadata ...\n";
    return;

  } elsif ( $exit == 1 ) {

    if ( defined $create_on_missing ) {

      get_metadata_from_system();
      set_note();
      print "Missing note created.\n";

      return;

    }

    print "

  !!! This commit does not have a note associated with it. !!!

  Your git action has successfully completed, but no permissions have
  been set.

  To create a note for this commit, run the following command from the
  top level of your git repository:

  .git/hooks/handle_metadata --save

  If you wish this to happen automatically, edit the
  .git/hooks/post-commit file and add the '--create-on-missing' option.

";

    return;

  }

  my ( $out, $show_err ) = run_cmd( qw( git notes --ref ), $NOTE_NS, qw( show HEAD ) );

  if ( $show_err ) {

    warn "$show_err\n\nNot setting metadata ...\n";
    return;

  }

  %metadata = %{ JSON::PP->new->utf8->decode( $out ) };

  names_to_bytes( \%metadata );

  return 1;

} ## end sub get_note

# A path is a string of bytes, and every name in the note arrived as one --
# git handed it over verbatim and lstat, chmod, and utime all want it back
# that way. Decoding the note turns those bytes into characters, so a name
# outside ASCII would otherwise be handed to the filesystem as its UTF-8
# encoding and match nothing.
#
# A name that will not fit in bytes cannot have come from a path here, so it
# is left as it is rather than made fatal in the middle of a restore.

sub names_to_bytes {

  my ( $metadata ) = @_;

  for my $md ( values %$metadata ) { ## no critic qw( References::ProhibitDoubleSigils )

    for my $inode ( values %$md ) { ## no critic qw( References::ProhibitDoubleSigils )

      utf8::downgrade( $_, 1 ) for @{ $inode->{ name } || [] };

    }
  }

  return;

} ## end sub names_to_bytes

sub chown_file {

  my ( $chown_file ) = @_;

  for my $attr ( keys %$chown_file ) { ## no critic qw( References::ProhibitDoubleSigils )

    my ( $uid, $gid ) = split /_/, $attr, 2;
    my @files = @{ $chown_file->{ $attr } };

    ! defined $quiet && warn "chown $uid, $gid, @files\n";

    my $chowned = chown $uid, $gid, @files;

    warn "Unable to change owner and/or group for one or more files: $!\n"
      unless $chowned == @files;

  }

  return;

} ## end sub chown_file

sub chmod_file {

  my ( $chmod_file ) = @_;

  for my $chmod ( keys %$chmod_file ) { ## no critic qw( References::ProhibitDoubleSigils )

    my @files = @{ $chmod_file->{ $chmod } };

    # The names are an argument, never part of the format: interpolating them
    # into it lets a tracked file called '100%n' supply a directive of its own
    # and abort the run mid-restore.
    ! defined $quiet && warn sprintf "chmod %04o, %s\n", oct $chmod, "@files";

    my $chmodded = chmod oct $chmod, @files;

    warn "Unable to change mode for one or more files: $!\n"
      unless $chmodded == @files;

  }

  return;

} ## end sub chmod_file

sub touch_file {

  my ( $touch_file ) = @_;

  for my $time ( keys %$touch_file ) { ## no critic qw( References::ProhibitDoubleSigils )

    my ( $atime, $mtime ) = split /_/, $time, 2;
    my @files = @{ $touch_file->{ $time } };

    ! defined $quiet && warn "touch -a $atime -m $mtime @files\n";

    my $touched = utime $atime, $mtime, @files;

    warn "Unable to touch one or more files: $!\n"
      unless $touched == @files;

  }

  return;

} ## end sub touch_file

sub extnd_attr {

  my ( $extnd_attr ) = @_;

  while ( my ( $f, $x ) = each %$extnd_attr ) { ## no critic qw( References::ProhibitDoubleSigils )

    # Nothing was recorded for this file, so there is nothing to restore.
    next if ! defined $x;

    ! defined $quiet && warn "chattr $x $f\n";

    set_file_flags( $f, $x )
      or warn "Unable to set extended attributes on $f\n";

  }

  return;

} ## end sub extnd_attr

# Recreate a fifo, character device, or block device. Only root can make the
# device nodes, so the mknod(1) call is the root-only path; a fifo goes
# through POSIX::mkfifo, which needs no privilege and no external command.
#
# The mode is left to the caller: every name handled here is also queued for
# chmod, which runs immediately afterwards.

sub make_special_file {

  my ( $name, $mode, $rdev ) = @_;

  if ( S_ISFIFO( $mode ) ) {

    mkfifo( $name, $mode & 07777 )
      or warn "Problem making fifo $name: $!\n";

    return;

  }

  my $type
    = S_ISCHR( $mode ) ? 'c'
    : S_ISBLK( $mode ) ? 'b'
    :                    undef;

  if ( ! defined $type ) {

    warn "Unknown special file type for $name, skipping\n";
    return;

  }

  # glibc splits a dev_t's major and minor numbers across the value rather
  # than storing them contiguously (sys/sysmacros.h), and that is the encoding
  # perl's stat reports.
  my $major = ( ( $rdev >> 8 ) & 0xfff ) | ( ( $rdev >> 32 ) & ~0xfff );
  my $minor = ( $rdev & 0xff ) | ( ( $rdev >> 12 ) & ~0xff );

  my ( $out, $err, $syserr ) = run_cmd( 'mknod', '--', $name, $type, $major, $minor );

  warn "Problem making special file $name: $err\n"
    if $syserr;

  return;

} ## end sub make_special_file

# Read the ext2 attribute flags of a file, or undef if they cannot be read.
# Opening non-blocking keeps a fifo from stalling the whole run, and matches
# what lsattr(1) does.

sub get_file_flags {

  my ( $file ) = @_;

  sysopen my $fh, $file, O_RDONLY | O_NONBLOCK
    or return;

  my $flags = read_flags( $fh );

  close $fh;

  return $flags;

}

# Restore the recorded flags, keeping the bits the kernel will not accept from
# userspace as the file already has them.

sub set_file_flags {

  my ( $file, $flags ) = @_;

  sysopen my $fh, $file, O_RDONLY | O_NONBLOCK
    or return;

  my $current = read_flags( $fh );

  return if ! defined $current;

  my $wanted = ( $current & FS_READONLY_FLAGS ) | ( $flags & ~FS_READONLY_FLAGS );
  my $packed = pack 'L!', $wanted;

  my $set = ioctl $fh, FS_IOC_SETFLAGS, $packed;

  close $fh;

  return $set;

} ## end sub set_file_flags

sub read_flags {

  my ( $fh ) = @_;

  # The ioctl is declared to take a long, so the buffer is sized to one, but
  # the kernel exchanges an int through it.
  my $packed = pack 'L!', 0;

  return if ! ioctl $fh, FS_IOC_GETFLAGS, $packed;

  return scalar unpack 'L!', $packed;

}

sub restor_ctx {

  my ( $restor_ctx ) = @_;

  return if ! $se_enforcing;

  my $top = $topdir =~ m{/$} ? $topdir : $topdir . '/';

  # `open FH, "|cmd" || warn ...` parsed as open( FH, ( "|cmd" || warn ... ) ):
  # || binds tighter than the list operator, so the string was simply truthy
  # and the warning could never fire. `or` binds looser, which is the whole
  # reason it exists. The list form also keeps the shell out of the command.
  open my $restorecon, '|-', 'restorecon', '-f-', '-v'
    or do { warn "Unable to execute restorecon: $!\n"; return };

  for my $file ( @$restor_ctx ) {

    ! defined $quiet && warn "restorecon $top$file\n";

    print { $restorecon } "$top$file\n";

  }

  # A command on the far end of a pipe is only reaped when the pipe closes, so
  # this is where its exit status turns up -- open reports nothing but its own
  # failure to start the thing.
  close $restorecon
    or warn sprintf "restorecon exited %d\n", $? >> 8;

  return;

} ## end sub restor_ctx
